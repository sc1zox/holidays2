---
interface Props {
    headline: string,
    subline?: string,
    paragraph?: string,
}

const {headline, subline, paragraph} = Astro.props;
---
<div class="bg-gradient-company-color w-100 d-flex flex-column justify-content-center align-items-center p-3 text-white">
    <h1 class="display-6 responsive-headline-light text-center w-100 text-wrap text-lg-nowrap">{headline}</h1>
    <h2 class="display-10 responsive-text-light text-center w-lg-75 text-wrap">{subline}</h2>
    <p class="display-11 responsive-text-light text-center w-lg-75 text-wrap">{paragraph}</p>
</div>